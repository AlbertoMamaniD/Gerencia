# AhorraTech — variables de entorno (copiar a .env y completar).
# IMPORTANTE: las variables EXPO_PUBLIC_* se incrustan en el binario de la app
# y cualquiera puede extraerlas. Usa solo claves restringidas (Gemini con
# restricción por app/cuota; Supabase solo con la anon key + RLS).
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
