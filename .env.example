# AhorraTech — variables de entorno de la app (copiar a .env).
#
# Todo lo que empieza con EXPO_PUBLIC_ queda DENTRO del APK y cualquiera puede leerlo.
# Por eso aquí solo van la URL y la anon key de Supabase, que son públicas por diseño
# y están protegidas por las políticas RLS (supabase/migrations).
#
# La clave de Google Gemini NO va aquí: se guarda como secreto de la Edge Function
#   npx supabase secrets set GEMINI_API_KEY=...
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
